NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Leave empty to use the persistent local MongoDB started by npm run dev.
# For Atlas, use a mongodb+srv URI. A replica set is required for transactions.
MONGO_URI=
# npm run setup generates a cryptographically random secret in .env.
JWT_SECRET=
LOG_LEVEL=info
# Local development: writes actual .eml messages to .local/mail.
# Production: set MAIL_TRANSPORT=smtp and configure the SMTP settings.
MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CapMoney <no-reply@capmoney.local>
# Optional existing mongod executable; otherwise downloaded into .local/binaries.
MONGOMS_SYSTEM_BINARY=

# MB Bank auto-sync: use a random secret configured identically in the provider.
# SePay sends Authorization: Apikey <secret>. Never expose this secret in VITE_*.
MBBANK_WEBHOOK_SECRET=
# Optional alias; takes precedence over MBBANK_WEBHOOK_SECRET when set.
SEPAY_WEBHOOK_SECRET=
# The real MongoDB user ID returned by /api/auth/me and the linked MB account.
# Required: webhooks never choose the first user or trust a userId in the payload.
MBBANK_USER_ID=
MBBANK_USER_EMAIL=
MBBANK_ACCOUNT_NUMBER=
