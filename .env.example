NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Leave empty to use the persistent local MongoDB started by npm run dev.
# For Atlas, use a mongodb+srv URI. A replica set is required for transactions.
MONGO_URI=
# npm run setup generates a cryptographically random secret in .env.
JWT_SECRET=
LOG_LEVEL=info
# Local development: writes actual .eml messages to .local/mail.
# Production: set MAIL_TRANSPORT=smtp and configure the SMTP settings.
MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CapMoney <no-reply@capmoney.local>
# Optional existing mongod executable; otherwise downloaded into .local/binaries.
MONGOMS_SYSTEM_BINARY=

# Webhook secret for MB Bank / SePay auto-sync
MBBANK_WEBHOOK_SECRET=capmoney_mbbank_secret_key_2026
