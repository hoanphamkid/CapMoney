{
  "version": 2,
  "framework": "vite",
  "installCommand": "rm -rf node_modules ../node_modules && npm install --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/webhooks/mbbank", "destination": "/api/webhooks/mbbank" },
    { "source": "/api/webhooks/sepay", "destination": "/api/webhooks/sepay" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
